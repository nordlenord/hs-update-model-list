    {
      "id": "claude-resources",
      "title": "Claude configuration folder",
      "group": "Agent Instructions & Skills",
      "description": "Browse project-scoped configuration, instructions, and skills. Unrecognized text resources are available in the source editor.",
      "match": {
        "directories": [
          ".claude"
        ]
      },
      "format": "text",
      "views": [
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": ""
      },
      "ui": {
        "advanced": true,
        "order": 107,
        "saveLabel": "Save changes",
        "createLabel": "Create configuration"
      },
      "discovery": {
        "mode": "browser",
        "exclude": [
          {
            "patterns": [
              "**/.env",
              "**/.env.*",
              "**/*credential*",
              "**/*secret*",
              "**/*token*",
              "**/auth.json",
              "**/*.pem",
              "**/*.key"
            ],
            "reason": "Credentials are excluded from general settings discovery."
          },
          {
            "patterns": [
              "**/cache/",
              "**/logs/",
              "**/history/",
              "**/sessions/",
              "**/*.log",
              "**/*.db",
              "**/*.sqlite*",
              "**/node_modules/",
              ".git/"
            ],
            "reason": "Caches, logs, and internal state are not settings."
          },
          {
            "patterns": [
              "skills/"
            ],
            "reason": "Skill packages are presented in Skills."
          },
          {
            "patterns": [
              "CLAUDE.md",
              "GEMINI.md",
              "settings.local.json",
              "settings.json"
            ],
            "reason": "Known documents and tool settings have dedicated pages."
          }
        ]
      }
    },
