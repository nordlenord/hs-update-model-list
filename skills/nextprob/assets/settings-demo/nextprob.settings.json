    {
      "id": "editor-config",
      "title": "Editor configuration",
      "group": "Developer Tools",
      "description": "Shared editor conventions. Edit the original INI-style text; its semantics are interpreted by your editor.",
      "match": {
        "paths": [
          ".editorconfig"
        ]
      },
      "format": "ini",
      "views": [
        "structured",
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": ""
      },
      "ui": {
        "advanced": true,
        "order": 110,
        "saveLabel": "Save changes",
        "createLabel": "Create configuration",
        "editor": "ini",
        "defaultView": "structured",
        "emptyMessage": "No shared editor conventions.",
        "iniFields": [
          {
            "key": "root",
            "title": "Stop looking for parent configuration",
            "scope": "root",
            "options": [
              {
                "value": "true",
                "label": "Yes"
              },
              {
                "value": "false",
                "label": "No"
              }
            ]
          },
          {
            "key": "indent_style",
            "title": "Indent using",
            "scope": "section",
            "options": [
              {
                "value": "space",
                "label": "Spaces"
              },
              {
                "value": "tab",
                "label": "Tabs"
              }
            ]
          },
          {
            "key": "indent_size",
            "title": "Indent size",
            "scope": "section",
            "type": "text"
          },
          {
            "key": "end_of_line",
            "title": "Line endings",
            "scope": "section",
            "options": [
              {
                "value": "lf",
                "label": "LF"
              },
              {
                "value": "crlf",
                "label": "CRLF"
              },
              {
                "value": "cr",
                "label": "CR"
              }
            ]
          },
          {
            "key": "charset",
            "title": "Text encoding",
            "scope": "section",
            "options": [
              {
                "value": "utf-8",
                "label": "UTF-8"
              },
              {
                "value": "utf-8-bom",
                "label": "UTF-8-BOM"
              },
              {
                "value": "latin1",
                "label": "LATIN1"
              },
              {
                "value": "utf-16be",
                "label": "UTF-16BE"
              },
              {
                "value": "utf-16le",
