{
  "version": 1,
  "definitions": [
    {
      "id": "project-display",
      "title": "Sidebar",
      "group": "Appearance",
      "description": "Choose what appears in your sidebar and how it is organized.",
      "match": {
        "paths": [
          "nextprob.config.json"
        ]
      },
      "format": "json",
      "views": [
        "structured",
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": "{\n  \"version\": 1\n}\n"
      },
      "schema": "schemas/project-config.schema.json",
      "ui": {
        "defaultView": "structured",
        "order": 0,
        "layout": [
          {
            "type": "group",
            "title": "General",
            "children": [
              {
                "type": "field",
                "path": [
                  "surfaces",
                  "sidebar",
                  "hideDotFolders"
                ],
                "title": "Hide files and folders starting with “.”",
                "control": "toggle",
                "default": true,
                "description": "Keep hidden project files out of folder views."
              }
            ]
          },
          {
            "type": "list",
            "path": [
              "surfaces",
              "sidebar",
              "sections"
            ],
            "title": "Sections",
            "description": "Expand a section to change its name, layout, or sorting. Move sections to set their order.",
            "default": [
              {
                "id": "favorites",
                "title": "Favorites",
                "view": "list",
                "collection": "favorites",
                "hideWhenEmpty": true
              },
              {
                "id": "files",
                "title": "Notes",
                "view": "tree",
                "source": "items",
                "hiddenFolders": [
                  ".claude",
                  ".vscode",
                  ".context",
                  "_templates"
                ]
              }
            ],
            "itemTitle": [
              "title"
            ],
            "keyField": "id",
            "reorderable": true,
            "removable": true,
            "itemTemplate": {
              "id": "section",
              "title": "New section",
              "view": "list",
              "source": "notes"
            },
            "addLabel": "+ Add section",
            "children": [
              {
                "type": "field",
                "path": [
                  "enabled"
                ],
                "title": "Show section",
                "control": "toggle",
                "default": true,
                "summary": true
              },
              {
                "type": "field",
                "path": [
                  "title"
                ],
                "title": "Section name"
              },
              {
                "type": "field",
                "path": [
                  "view"
                ],
                "title": "Display as",
                "control": "select",
                "options": [
                  {
                    "value": "list",
                    "label": "List"
                  },
                  {
                    "value": "tree",
                    "label": "Folder tree"
                  }
                ],
                "clearOnChange": [
                  [
                    "hiddenFolders"
                  ]
                ]
              },
              {
                "type": "field",
                "path": [
                  "sort"
                ],
                "title": "Sort by",
                "control": "select",
                "options": [
                  {
                    "value": "title",
                    "label": "Title"
                  },
                  {
                    "value": "name",
                    "label": "Name"
                  },
                  {
                    "value": "path",
                    "label": "File path"
                  },
                  {
                    "value": "modifiedAt",
                    "label": "Last modified"
                  },
                  {
                    "value": "favoriteOrder",
                    "label": "My favorites order"
                  }
                ],
                "optional": true,
                "emptyLabel": "Use collection order / name"
              },
              {
                "type": "group",
                "title": "More options",
                "children": [
                  {
                    "type": "field",
                    "path": [
                      "hideWhenEmpty"
                    ],
                    "title": "Hide when empty",
                    "control": "toggle",
                    "default": false
                  },
                  {
                    "type": "field",
                    "path": [
                      "hiddenFolders"
                    ],
                    "title": "Excluded folders",
                    "control": "lines",
                    "visibleWhen": {
                      "path": [
                        "view"
                      ],
                      "equals": "tree"
                    },
                    "description": "One project-relative folder per line. Its contents are hidden in this section."
                  },
                  {
                    "type": "group",
                    "title": "Content selection",
                    "children": [
                      {
                        "type": "field",
                        "path": [
                          "source"
                        ],
                        "title": "Include",
                        "control": "select",
                        "options": [
                          {
                            "value": "items",
                            "label": "All files and notes"
                          },
                          {
                            "value": "notes",
                            "label": "Notes only"
                          }
                        ],
                        "emptyLabel": "Use a collection",
                        "clearOnChange": [
                          [
                            "collection"
                          ]
                        ]
                      },
                      {
                        "type": "field",
                        "path": [
                          "collection"
                        ],
                        "title": "Collection",
                        "control": "select",
                        "optionsFrom": [
                          "collections"
                        ],
                        "emptyLabel": "Use the selection above",
                        "clearOnChange": [
                          [
                            "source"
                          ]
                        ]
                      },
                      {
                        "type": "field",
                        "path": [
                          "id"
                        ],
                        "title": "Section ID",
                        "description": "Keep this stable to preserve saved section preferences."
                      }
                    ],
                    "collapsed": true
                  }
                ],
                "collapsed": true
              }
            ]
          },
          {
            "type": "group",
            "title": "Advanced",
            "children": [
              {
                "type": "map",
                "path": [
                  "collections"
                ],
                "title": "Custom collections",
                "description": "Reusable selections of files and notes. Section references use these names; update references before removing a collection.",
                "default": {
                  "favorites": {
                    "source": "items",
                    "where": {
                      "===": [
                        {
                          "var": "favorite"
                        },
                        true
                      ]
                    },
                    "sort": "favoriteOrder"
                  }
                },
                "mergeDefaults": true,
                "removable": false,
                "itemTemplate": {
                  "source": "notes"
                },
                "addLabel": "+ Add collection",
                "children": [
                  {
                    "type": "field",
                    "path": [
                      "source"
                    ],
                    "title": "Include",
                    "control": "select",
                    "options": [
                      {
                        "value": "items",
                        "label": "All files and notes"
                      },
                      {
                        "value": "notes",
                        "label": "Notes only"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "path": [
                      "sort"
                    ],
                    "title": "Default sort order",
                    "control": "select",
                    "options": [
                      {
                        "value": "title",
                        "label": "Title"
                      },
                      {
                        "value": "name",
                        "label": "Name"
                      },
                      {
                        "value": "path",
                        "label": "File path"
                      },
                      {
                        "value": "modifiedAt",
                        "label": "Last modified"
                      },
                      {
                        "value": "favoriteOrder",
                        "label": "My favorites order"
                      }
                    ],
                    "optional": true,
                    "emptyLabel": "Name"
                  },
                  {
                    "type": "group",
                    "title": "Custom filter",
                    "children": [
                      {
                        "type": "field",
                        "path": [
                          "where"
                        ],
                        "title": "Filter rule",
                        "control": "json",
                        "description": "Advanced JSONLogic rule. Leave blank to include everything from the selected source."
                      }
                    ],
                    "collapsed": true
                  }
                ]
              }
            ],
            "collapsed": true
          }
        ],
        "saveLabel": "Save changes",
        "createLabel": "Create configuration",
        "emptyMessage": "Using the default sidebar layout."
      }
    },
    {
      "id": "git-ignore",
      "title": "Git ignore rules",
      "group": "Sync & Git",
      "description": "Patterns are evaluated in order. Comments and exceptions are preserved.",
      "match": {
        "paths": [
          ".gitignore"
        ]
      },
      "format": "line-rules",
      "views": [
        "rules",
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": ""
      },
      "managedSections": [
        {
          "start": "# NextProb managed skills (auto-updated)",
          "end": "# /NextProb managed skills",
          "label": "NextProb installed skills (automatically updated)"
        }
      ],
      "ui": {
        "advanced": true,
        "order": 100,
        "saveLabel": "Save changes",
        "createLabel": "Save exclusions",
        "defaultView": "rules",
        "editor": "rules",
        "emptyMessage": "No custom exclusions. Application exclusions still apply."
      }
    },
    {
      "id": "sync-ignore",
      "title": "Sync ignore rules",
      "group": "Sync & Git",
      "description": "Patterns are evaluated in order. Comments and exceptions are preserved.",
      "match": {
        "paths": [
          ".syncignore"
        ]
      },
      "format": "line-rules",
      "views": [
        "rules",
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": ""
      },
      "ui": {
        "advanced": true,
        "order": 101,
        "saveLabel": "Save changes",
        "createLabel": "Save exclusions",
        "defaultView": "rules",
        "editor": "rules",
        "emptyMessage": "No custom exclusions. Application exclusions still apply."
      }
    },
    {
      "id": "project-settings-definitions",
      "title": "Customize settings panel",
      "group": "Advanced",
      "description": "Register project files and choose how they appear in settings.",
      "match": {
        "paths": [
          "nextprob.settings.json"
        ]
      },
      "format": "json",
      "views": [
        "structured",
        "source"
      ],
      "creation": {
        "mode": "explicit",
        "initialText": "{\n  \"version\": 1,\n  \"definitions\": []\n}\n"
      },
      "schema": "schemas/catalog.schema.json",
      "ui": {
        "advanced": true,
        "order": 103,
        "saveLabel": "Save changes",
        "createLabel": "Create configuration",
        "defaultView": "structured",
        "editor": "catalog",
        "layout": [
          {
            "type": "list",
            "path": [
              "definitions"
            ],
            "title": "Registered settings",
            "description": "These project definitions extend or replace the built-in definitions.",
            "keyField": "id",
            "itemTitle": [
              "title"
            ],
            "removable": true,
            "itemTemplate": {
              "id": "custom-settings",
              "title": "New settings",
              "group": "AI assistance",
              "description": "",
              "match": {
                "paths": [
                  "tools/preferences.json"
                ]
              },
              "format": "json",
              "views": [
                "structured",
                "source"
              ],
              "creation": {
                "mode": "explicit",
                "initialText": "{}\n"
              },
              "ui": {
                "saveLabel": "Save changes",
                "createLabel": "Create configuration"
              }
            },
            "addLabel": "+ Register settings",
            "children": [
              {
                "type": "field",
                "path": [
                  "title"
                ],
                "title": "Page title"
              },
              {
                "type": "field",
                "path": [
                  "group"
                ],
                "title": "Category"
              },
              {
                "type": "field",
                "path": [
                  "description"
                ],
                "title": "Description"
              },
              {
                "type": "group",
                "title": "File and editor",
                "collapsed": true,
                "children": [
                  {
                    "type": "field",
                    "path": [
                      "id"
                    ],
                    "title": "Definition ID"
                  },
                  {
                    "type": "field",
                    "path": [
                      "match",
                      "paths"
                    ],
                    "title": "File paths",
                    "control": "lines"
                  },
                  {
                    "type": "field",
                    "path": [
                      "format"
                    ],
                    "title": "File format",
                    "control": "select",
                    "options": [
                      {
                        "value": "text",
                        "label": "text"
                      },
                      {
                        "value": "markdown",
                        "label": "markdown"
                      },
                      {
                        "value": "json",
                        "label": "json"
                      },
                      {
                        "value": "line-rules",
                        "label": "line-rules"
                      },
                      {
                        "value": "ini",
                        "label": "ini"
                      }
                    ]
                  },
                  {
                    "type": "field",
                    "path": [
                      "views"
                    ],
                    "title": "Available views",
                    "control": "lines"
                  },
                  {
                    "type": "field",
                    "path": [
                      "schema"
                    ],
                    "title": "Schema path",
                    "optional": true
                  },
                  {
                    "type": "field",
                    "path": [
                      "creation"
                    ],
                    "title": "Creation template",
                    "control": "json"
                  }
                ]
              },
              {
                "type": "group",
                "title": "Advanced presentation",
                "collapsed": true,
                "children": [
                  {
                    "type": "field",
                    "path": [
                      "ui"
                    ],
                    "title": "Layout and presentation",
                    "control": "json"
                  },
                  {
                    "type": "field",
                    "path": [
                      "discovery"
                    ],
                    "title": "Folder discovery policy",
                    "control": "json"
                  }
                ]
              }
            ]
          },
          {
            "type": "group",
            "title": "Page navigation",
            "collapsed": true,
            "children": [
              {
                "type": "field",
                "path": [
                  "pages"
                ],
                "title": "Page definitions",
                "control": "json",
                "description": "Advanced: pages group registered resources. Built-in pages remain unless overridden by ID."
              }
            ]
          }
        ]
      }
    },
