          "hiddenFolders": [
            ".claude",
            ".vscode",
            ".context",
            "_templates",
            ".gemini",
            ".codex",
            ".opencode",
            ".pi",
            ".Trash"
          ],
          "hiddenFiles": [
            "AGENTS.md",
            "AGENTS.override.md",
            "AGENTS.MD",
            "CLAUDE.md",
