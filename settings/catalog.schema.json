{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextProb settings catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "definitions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "definitions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/definition"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\u0000).*[^/]$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "group",
        "description",
        "match",
        "format",
        "views",
        "creation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "directories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        },
        "format": {
          "enum": [
            "text",
            "markdown",
            "json",
            "line-rules"
          ]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "preview",
              "structured",
              "rules"
            ]
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "initialText"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "initialText": {
              "type": "string"
            }
          }
        },
        "managedSections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "label"
            ],
            "properties": {
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "schema": {
          "$ref": "#/$defs/relativePath"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      }
    },
    "formNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "group",
            "field",
            "list",
            "map"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "children": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/formNode"
          }
        },
        "collapsed": {
          "type": "boolean"
        },
        "default": {},
        "mergeDefaults": {
          "type": "boolean"
        },
        "control": {
          "enum": [
            "text",
            "toggle",
            "select",
            "number",
            "lines",
            "json"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "emptyLabel": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {},
              "label": {
                "type": "string"
              }
            }
          }
        },
        "optionsFrom": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "clearOnChange": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "visibleWhen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "equals"
          ],
          "properties": {
            "path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "enum": [
                        "__proto__",
                        "prototype",
                        "constructor"
                      ]
                    }
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "equals": {}
          }
        },
        "itemTitle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "keyField": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "reorderable": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        },
        "itemTemplate": {},
        "addLabel": {
          "type": "string"
        },
        "summary": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "group",
                  "list",
                  "map"
                ]
              }
            }
          },
          "then": {
            "required": [
              "title",
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "field",
                  "list",
                  "map"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultView": {
          "enum": [
            "source",
            "structured"
          ]
        },
        "order": {
          "type": "integer"
        },
        "advanced": {
          "type": "boolean"
        },
        "layout": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/formNode"
          }
        }
      }
    }
  }
}
